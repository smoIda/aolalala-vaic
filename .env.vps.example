# ---- Copy to .env on the VPS and fill in real values ----
#   cp .env.vps.example .env

# Public address Caddy serves on. Pick ONE:
#   - sslip.io (zero setup): replace dots in your VPS public IP with dashes,
#       e.g. IP 140.238.1.23  ->  SITE_ADDRESS=140-238-1-23.sslip.io
#   - DuckDNS (free subdomain): SITE_ADDRESS=yourname.duckdns.org
#   - No DNS yet / HTTP only:   SITE_ADDRESS=:80
# With a hostname, Caddy auto-provisions a Let's Encrypt HTTPS certificate.
SITE_ADDRESS=140-238-1-23.sslip.io

# Frontend -> backend calls. Leave as /api (same origin via Caddy). Only change
# if you serve the backend on a different origin.
PUBLIC_API_URL=/api

# Soniox Speech-to-Text API key (https://console.soniox.com)
SONIOX_API_KEY=

# Postgres (chatbot knowledge DB). CHANGE THE PASSWORD.
CHATBOT_DB_NAME=chatbot
CHATBOT_DB_USER=chatbot
CHATBOT_DB_PASSWORD=change-me-strong-password

# OpenRouter (LLM). Without a key the chatbot's grounded answers degrade.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=~openai/gpt-latest
OPENROUTER_APP_TITLE=Hert Hospital Chatbot

# External dashboard for tickets/appointments. Leave default if you don't have
# one — chat + voice still work, only ticket creation will fail.
DASHBOARD_API_URL=http://localhost:8000/api/internal
INTERNAL_API_KEY=dev-internal-key

# AI provider request logging
AI_PROVIDER_LOG_ENABLED=false
